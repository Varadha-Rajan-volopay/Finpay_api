{
  "info": {
    "name": "FinpayAPI - Expense CRUD, Filtering & Pagination",
    "description": "Expense API testing collection. Set the Bearer token in collection Authorization. Replace example expense ID 1 with the ID returned by Create Expense.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "PASTE_YOUR_JWT_TOKEN_HERE",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1 - Create Expense",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expense\": {\n    \"category_id\": 1,\n    \"title\": \"Postman test expense\",\n    \"amount_cents\": 2500,\n    \"currency\": \"INR\",\n    \"incurred_on\": \"2026-10-30\",\n    \"notes\": \"Created from Postman\"\n  }\n}"
        },
        "url": {
          "raw": "http://localhost:3000/expenses",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["expenses"]
        }
      }
    },
    {
      "name": "2 - List Expenses",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:3000/expenses",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["expenses"]
        }
      }
    },
    {
      "name": "3 - Show Expense",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:3000/expenses/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["expenses", "1"]
        }
      }
    },
    {
      "name": "4 - Filter Expenses",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:3000/expenses?category_id=1&status=pending&from=2026-10-01&to=2026-10-30",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["expenses"],
          "query": [
            {
              "key": "category_id",
              "value": "1"
            },
            {
              "key": "status",
              "value": "pending"
            },
            {
              "key": "from",
              "value": "2026-10-01"
            },
            {
              "key": "to",
              "value": "2026-10-30"
            }
          ]
        }
      }
    },
    {
      "name": "5 - Offset Pagination",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:3000/expenses?page=2&per=10",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["expenses"],
          "query": [
            {
              "key": "page",
              "value": "2"
            },
            {
              "key": "per",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "6 - Pagination Maximum",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:3000/expenses?page=1&per=500",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["expenses"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "per",
              "value": "500"
            }
          ]
        }
      }
    },
    {
      "name": "7 - Keyset Pagination First Page",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:3000/expenses?pagination=keyset&per=10",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["expenses"],
          "query": [
            {
              "key": "pagination",
              "value": "keyset"
            },
            {
              "key": "per",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "8 - Update Expense",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expense\": {\n    \"title\": \"Updated from Postman\",\n    \"notes\": \"Updated test note\"\n  }\n}"
        },
        "url": {
          "raw": "http://localhost:3000/expenses/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["expenses", "1"]
        }
      }
    },
    {
      "name": "9 - Invalid Status Filter",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:3000/expenses?status=not_a_status",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["expenses"],
          "query": [
            {
              "key": "status",
              "value": "not_a_status"
            }
          ]
        }
      }
    },
    {
      "name": "10 - Delete Expense",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "http://localhost:3000/expenses/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["expenses", "1"]
        }
      }
    }
  ]
}