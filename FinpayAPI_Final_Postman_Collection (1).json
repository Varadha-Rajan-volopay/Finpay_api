{
  "info": {
    "_postman_id": "e40dada5-c02a-4482-b7ed-771b2afe8bb8",
    "name": "FinpayAPI - Final Complete Integration Testing",
    "description": "Final FinpayAPI collection modeled on the supplied invitation-flow collection: ordered requests, concrete Orion account data, automatic token/category/expense/receipt ID capture, request assertions, and Idempotency-Key headers for workflow actions. The existing Orion Technologies tenant is reused; company registration and duplicate user registration are not included. Run requests in folder order. Expenses are created as the member so the admin can approve them (the admin cannot approve their own expense under the current policy). Receipt upload requires choosing a real local file in form-data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "01 Login as Company Admin",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": {\n    \"subdomain\": \"orion_tech_2026\"\n  },\n  \"user\": {\n    \"email\": \"admin@orion.test\",\n    \"password\": \"Admin@2026Test\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Uses your existing Orion Technologies admin. Company registration is omitted because this tenant already exists."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin login returns 200', () => pm.response.to.have.status(200));",
                  "const d=pm.response.json(); const t=d.access_token||d.token||d.jwt||d.data?.access_token||d.data?.token;",
                  "pm.expect(t,'access token').to.be.a('string').and.not.empty; pm.collectionVariables.set('access_token',t);",
                  "const rt=d.refresh_token||d.data?.refresh_token; if(rt) pm.collectionVariables.set('refresh_token',rt);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Current Logged-in Admin",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
