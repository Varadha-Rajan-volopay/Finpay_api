              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "description": "Body must be form-data. The key is file and its type is File. After importing, open this request, click Body > form-data, click Select Files for the file row, and choose a real PDF/JPG/PNG receipt (max 10 MB). Do not add Content-Type manually; Postman sets multipart/form-data with its boundary."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Receipt upload returns 200 or 201',()=>pm.expect([200,201]).to.include(pm.response.code));",
                  "if([200,201].includes(pm.response.code)){const d=pm.response.json();const r=d.receipt||d.data?.receipt||d.data||d;const id=r.id||d.id;if(id)pm.collectionVariables.set('receipt_id',String(id));}"
                ]
              }
            }
          ]
