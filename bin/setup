#!/usr/bin/env ruby
require "fileutils"
require "rbconfig"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  puts "== Loading local environment =="

  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  puts "\n== Starting PostgreSQL and Redis =="
  system! "docker", "compose", "up", "-d", "--wait"

  puts "\n== Preparing database =="
  system! RbConfig.ruby, "bin/rails", "db:prepare"  
  system! RbConfig.ruby, "bin/rails", "db:reset" if ARGV.include?("--reset")

  puts "\n== Clearing logs and temporary files =="
  system! RbConfig.ruby, "bin/rails", "log:clear", "tmp:clear"

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush
    exec "bin/dev"
  end
end
